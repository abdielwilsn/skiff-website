---
import Logo from "./Logo.astro";
const sites = [
  { d: "chicd.org", kind: "Laravel", repo: "abdielwilsn/chicd", branch: "main", status: "Ready", tone: "ok", when: "2m ago", https: true, auto: true, envs: ["staging"] },
  { d: "shop.example.com", kind: "Next.js", repo: "acme/storefront", branch: "production", status: "Building", tone: "info", when: "now", https: true, auto: true, envs: ["staging", "preview"] },
  { d: "api.example.com", kind: "Django", repo: "acme/api", branch: "main", status: "Ready", tone: "ok", when: "1h ago", https: true, auto: false, envs: [] },
];
const nav = ["Sites", "Server", "Repositories", "Databases", "Backups", "Settings"];
---
<div class="mock" aria-label="The Skiff panel: a sidebar, server stats and three deployed sites with their staging environments" role="img">
  <div class="mock-bar">
    <span class="dots"><i></i><i></i><i></i></span>
    <span class="mock-url">panel.yourdomain.com</span>
  </div>
  <div class="mock-app">
    <aside class="mock-side" aria-hidden="true">
      <span class="mock-brand"><Logo size={18} /> Skiff</span>
      <span class="mock-pill"><i></i>your-vps<em>Self-hosted</em></span>
      <ul class="mock-nav">
        {nav.map((n, i) => <li class={i === 0 ? "on" : ""}>{n}</li>)}
      </ul>
      <span class="mock-user"><span class="mock-avatar">A</span>admin</span>
    </aside>
    <div class="mock-main">
    <div class="mock-top"><span>Sites</span></div>
    <div class="mock-body">
      <div class="mock-head">
        <div><b>Sites</b><small>Laravel, JavaScript and Python apps on this server.</small></div>
        <span class="mock-btn">+ New site</span>
      </div>
      <div class="mock-strip">
        <span><small>CPU</small><b>12%</b></span>
        <span><small>Memory</small><b>41%</b></span>
        <span><small>Disk</small><b>23%</b></span>
        <span><small>Last backup</small><b>6h ago</b></span>
      </div>
      <div class="mock-grid">
        {sites.map((s) => (
          <div class="mock-card">
            <div class="mock-card-head">
              <span class="mono-badge">{s.d[0].toUpperCase()}</span>
              <div><b>{s.d}</b><small>{s.https ? "https" : "http"}://{s.d}</small></div>
            </div>
            <div class="mock-meta">
              <span><svg class="mi" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .2a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 8 .2z"/></svg>{s.repo}</span>
              <span>{s.kind}</span>
            </div>
            <div class="mock-meta">
              <span><svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="6" cy="6" r="2.5"/><circle cx="6" cy="18" r="2.5"/><circle cx="18" cy="8" r="2.5"/><path d="M6 8.5v7M18 10.5c0 4-6 3.5-11 6"/></svg><span class="mono">{s.branch}</span></span>
              {s.https && <span><svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></svg>HTTPS</span>}
              {s.auto && <span><svg class="mi" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M13 3 5 13.5h6L10 21l8-10.5h-6z"/></svg>Auto-deploy</span>}
            </div>
            {s.envs.length > 0 && <div class="mock-envs">{s.envs.map((e) => <span><i></i>{e}</span>)}</div>}
            <div class="mock-foot">
              <span class={`st st-${s.tone}`}><i></i>{s.status}</span>
              <small>{s.when}</small>
            </div>
          </div>
        ))}
      </div>
    </div>
    </div>
  </div>
</div>
