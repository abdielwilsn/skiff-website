---
import Base from "./Base.astro";
import Logo from "../components/Logo.astro";
import { docsNav } from "../docs-nav";
import "../styles/docs.css";

interface Props {
  frontmatter: { title: string; description: string };
  headings?: { depth: number; slug: string; text: string }[];
}
const { frontmatter, headings = [] } = Astro.props;
const repo = "https://github.com/abdielwilsn/skiff";
const path = Astro.url.pathname.replace(/\/$/, "") || "/docs";
const flat = docsNav.flatMap((g) => g.items);
const i = flat.findIndex((x) => x.href === path);
const prev = i > 0 ? flat[i - 1] : null;
const next = i >= 0 && i < flat.length - 1 ? flat[i + 1] : null;
const toc = headings.filter((h) => h.depth === 2);
const section = docsNav.find((g) => g.items.some((x) => x.href === path))?.title;
const editURL = `https://github.com/abdielwilsn/skiff-website/blob/main/src/pages${path === "/docs" ? "/docs/index" : path}.md`;
---
<Base title={`${frontmatter.title} · Skiff docs`} description={frontmatter.description}>
  <header class="nav">
    <div class="docs-wide nav-row">
      <a class="brand" href="/"><Logo size={26} /><span>Skiff</span></a>
      <span class="docs-badge">Docs</span>
      <nav class="nav-links" aria-label="Site">
        <a href="/">Home</a>
        <a href="/docs" aria-current={path === "/docs" ? "page" : undefined}>Documentation</a>
        <a href={`${repo}/releases`} target="_blank" rel="noopener">Releases</a>
      </nav>
      <a class="btn btn-ghost" href={repo} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 .2a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 8 .2z"/></svg>
        GitHub
      </a>
    </div>
  </header>

  <div class="docs-wide docs-grid">
    <details class="docs-menu" open>
      <summary>Menu · {flat[i]?.label ?? "Docs"}</summary>
      <nav class="docs-side" aria-label="Documentation">
        {docsNav.map((g) => (
          <div class="docs-group">
            <p>{g.title}</p>
            <ul>
              {g.items.map((x) => (
                <li><a href={x.href} aria-current={x.href === path ? "page" : undefined}>{x.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </details>

    <main class="docs-main">
      <article class="prose">
        {section && <p class="docs-section">{section}</p>}
        <h1>{frontmatter.title}</h1>
        <p class="docs-lead">{frontmatter.description}</p>
        <slot />
      </article>
      <nav class="docs-pager" aria-label="Previous and next">
        {prev ? <a href={prev.href}><small>Previous</small><span>← {prev.label}</span></a> : <span></span>}
        {next ? <a class="next" href={next.href}><small>Next</small><span>{next.label} →</span></a> : <span></span>}
      </nav>
      <p class="docs-edit"><a href={editURL} target="_blank" rel="noopener">Suggest a change to this page</a></p>
    </main>

    <aside class="docs-toc" aria-label="On this page">
      {toc.length > 1 && (
        <>
          <p>On this page</p>
          <ul>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </>
      )}
    </aside>
  </div>
  <script is:inline>
    // The sidebar is a collapsible menu on phones; start it closed there.
    if (matchMedia("(max-width: 820px)").matches) document.querySelector(".docs-menu").open = false;
  </script>
</Base>
