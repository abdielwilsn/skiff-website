---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import InstallCommand from "../components/InstallCommand.astro";
import PanelMock from "../components/PanelMock.astro";

const repo = "https://github.com/abdielwilsn/skiff";

const stacks = [
  {
    lang: "PHP",
    title: "Laravel",
    note: "PHP 8.2 – 8.5 per site, Composer, Artisan, migrations, queue workers and the scheduler.",
    items: ["Laravel", "Inertia", "Livewire", "Filament"],
  },
  {
    lang: "JavaScript · server",
    title: "Node apps",
    note: "Supervised by systemd behind Nginx and health-checked on every deploy. WebSockets work.",
    items: ["Next.js", "Nuxt", "SvelteKit", "Remix", "Astro SSR", "Express", "Fastify", "Any Node server"],
  },
  {
    lang: "JavaScript · static",
    title: "Static sites & SPAs",
    note: "Built on deploy and served straight from Nginx, with SPA fallback and long-lived asset caching.",
    items: ["Vite", "React", "Vue", "Svelte", "Astro", "Next.js export", "Create React App", "Plain HTML"],
  },
  {
    lang: "Python",
    title: "Python apps",
    note: "Python 3.11 – 3.14 installed with uv, a fresh virtualenv per release, gunicorn or uvicorn supervised behind Nginx. Django gets collectstatic and migrate.",
    items: ["Django", "FastAPI", "Flask", "Starlette", "Any WSGI or ASGI app"],
  },
];

const comingSoon = ["Ruby on Rails", "Go", "Bun", "Deno", "Elixir / Phoenix", "Docker"];

const features = [
  { icon: "zap", title: "git push is your deploy button", body: "Connect GitHub once. Every push to your branch builds and goes live through a signed webhook, and you watch the log stream as it happens." },
  { icon: "rollback", title: "Atomic releases, instant rollback", body: "Each deploy builds in its own release directory and goes live with an atomic symlink swap. A broken build never touches production, and your last five releases are one click away." },
  { icon: "clock", title: "Queues and cron, handled", body: "Run up to ten queue:work processes and the scheduler as supervised systemd services. They restart on every deploy, so your workers never run stale code." },
  { icon: "braces", title: "Apps that stay up", body: "Next.js, Nuxt, Django, FastAPI or your own server, supervised by systemd. If a new release doesn't boot, the previous one comes back automatically." },
  { icon: "node", title: "Pin your runtimes", body: "Pick PHP, Node.js and Python versions per site; Skiff installs them on first use. npm, pnpm or yarn is chosen from your lockfile." },
  { icon: "lock", title: "TLS in one click", body: "Let's Encrypt certificates, HTTP→HTTPS redirects and automatic renewal, for your sites and for the panel itself." },
  { icon: "envs", title: "Staging, then promote", body: "Give any site a staging environment on its own branch, domain, .env and database. When it looks right, promote the exact commit to production." },
  { icon: "db", title: "MySQL, PostgreSQL & Redis", body: "Install each in one click. A database and user per site, wired into your .env (DB_* for Laravel, DATABASE_URL for the rest) before migrations run." },
  { icon: "archive", title: "Backups you don't think about", body: "Every database dumped nightly and before each deploy, copied to any S3-compatible bucket, restorable in one click with a safety backup first." },
  { icon: "activity", title: "Know when something's off", body: "CPU, memory and disk with 24-hour charts, plus the state of Nginx, your databases and every app and worker. Warnings before the disk fills up." },
  { icon: "terminal", title: "SSH is optional", body: "Run migrations, seeders or any Artisan or shell command, and edit .env, straight from the browser." },
  { icon: "list", title: "Logs where you need them", body: "Deploy output streams live; app, worker and scheduler logs are one tab away. Your deploy script is plain bash you can read and change." },
  { icon: "shield", title: "Locked down by default", body: "Two-factor login with recovery codes, HTTPS from the very first page, and apps that run as an unprivileged user who never sees your GitHub token. Plus CSRF on every form and rate-limited logins." },
  { icon: "chip", title: "Fits on the smallest VPS", body: "One Go binary that idles around 16 MB of RAM. PHP-FPM spins up on demand, and small servers get swap automatically." },
  { icon: "key", title: "No lock-in", body: "Under the hood it's Nginx, systemd and bash on your own machine. Nothing proprietary sits between you and your app." },
];

const faqs = [
  { q: "Which stacks can I deploy today?", a: "Laravel; JavaScript (Next.js, Nuxt, SvelteKit, Remix, Astro and any Node server, plus static sites and SPAs built with Vite, Astro or Create React App); and Python (Django, FastAPI, Flask or any WSGI/ASGI app). Pick a preset when you create a site, then adjust the build and start commands if your setup is different." },
  { q: "Which databases are supported?", a: "MySQL 8, PostgreSQL and Redis, each installed on demand and listening on localhost only, plus SQLite. Skiff creates a database and user per site and writes the connection into your .env: DB_* for Laravel, DATABASE_URL and REDIS_URL for everything else." },
  { q: "Can I have a staging site?", a: "Yes. Add a staging (or preview) environment to any site: same repo and setup, its own branch, domain, .env and database. Test there, then promote the exact commit to production in one click; production's database is backed up first." },
  { q: "Are my databases backed up?", a: "Nightly and before every deploy, kept on the server and optionally copied to S3, R2, B2, Spaces or any S3-compatible bucket. Restores take a safety backup first and are one click." },
  { q: "What's coming next?", a: "Ruby on Rails, Go, Bun, Deno, Phoenix and Docker images are on the list, along with notifications and preview deployments for pull requests. The core (releases, rollbacks, supervised processes, health checks, Nginx) already works for any language, so new stacks mostly need a preset. Tell us what you want first on GitHub." },
  { q: "What does it cost?", a: "Nothing. Skiff is free and runs on the server you already pay for, so there's no per-server or per-site fee." },
  { q: "What do I need?", a: "A fresh Ubuntu 22.04 or 24.04 VPS (x86 or ARM) with root access. A domain is optional to start; you'll want one for HTTPS." },
  { q: "What happens when a deploy fails?", a: "Production keeps running. Every deploy builds in a fresh release directory and only goes live once each step succeeded. Node and Python apps are health-checked after the switch and rolled back automatically if they don't start." },
  { q: "How is the panel itself protected?", a: "It's served over HTTPS from the first start (self-signed until you give it a domain, then Let's Encrypt). Turn on two-factor login with any authenticator app; recovery codes and a server-side reset cover a lost phone. Sessions end after 12 hours idle, and you can sign out every other device. Deploys keep your GitHub token away from your apps, and the panel reads your sites' files with your apps' own permissions, never root's." },
  { q: "Where do my code and data go?", a: "Nowhere else. Skiff talks to GitHub through an OAuth app you own, and everything (settings, logs, databases) stays on your server." },
  { q: "How do I update Skiff?", a: "Run the install command again. It downloads the latest release, verifies the checksum, swaps the binary and keeps your sites and settings." },
  { q: "Can I manage several servers?", a: "Today each server runs its own Skiff. Managing a fleet from one central panel is on the roadmap." },
];
---
<Base
  title="Skiff: push-to-deploy on your own server, for Laravel, JavaScript and Python"
  description="Skiff is a tiny self-hosted panel for developers. Install it on any Ubuntu VPS, connect GitHub, and git push your Laravel, Next.js, Nuxt, Django or FastAPI apps to production, with staging, backups, PostgreSQL and Redis built in."
>
  <header class="nav">
    <div class="wrap nav-row">
      <a class="brand" href="/"><Logo size={26} /><span>Skiff</span></a>
      <nav class="nav-links" aria-label="Sections">
        <a href="#stacks">Stacks</a>
        <a href="#features">Features</a>
        <a href="#how">How it works</a>
        <a href="#faq">FAQ</a>
        <a href="/docs">Docs</a>
      </nav>
      <a class="btn btn-ghost" href={repo} target="_blank" rel="noopener">
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 .2a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.05-.49.05-.49.8.06 1.23.83 1.23.83.71 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.19c0 .21.15.46.55.38A8 8 0 0 0 8 .2z"/></svg>
        GitHub
      </a>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-inner">
        <a class="eyebrow" href={`${repo}/releases/latest`} target="_blank" rel="noopener"><span class="pulse-dot"></span>v0.4.2 · Two-factor login and HTTPS from the first click<span aria-hidden="true">→</span></a>
        <h1>You push. It ships.<br /><span class="dim">On a server you own.</span></h1>
        <p class="lead">Skiff is a tiny panel you install on your own VPS. Point it at a repo (Laravel, Next.js, Nuxt, SvelteKit, Django, FastAPI or plain Node) and it handles the runtime, Nginx, TLS, databases, workers, builds and backups. You keep writing code.</p>
        <InstallCommand />
        <p class="hero-note">Fresh Ubuntu 22.04 or 24.04, root access. Run it again any time to update.</p>
      </div>
      <div class="wrap">
        <PanelMock />
      </div>
    </section>

    <section class="stats">
      <div class="wrap stats-grid">
        <div><b>~13 MB</b><span>one static binary</span></div>
        <div><b>~16 MB</b><span>RAM at idle</span></div>
        <div><b>1</b><span>command to install &amp; update</span></div>
        <div><b>$0</b><span>panel fees, ever</span></div>
      </div>
    </section>

    <section id="stacks" class="section section-alt">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">Supported stacks</p>
          <h2>Bring your stack. Skiff runs it.</h2>
          <p class="sub">Pick a preset when you create a site, then tweak the build and start commands if you need to. Here's what works today, with more languages landing soon.</p>
        </div>
        <div class="stacks">
          {stacks.map((s) => (
            <article class="stack">
              <div class="stack-head">
                <span class="stack-lang">{s.lang}</span>
                <span class="stack-badge"><i></i>Available</span>
              </div>
              <h3>{s.title}</h3>
              <p>{s.note}</p>
              <ul class="chips">
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <div class="stack-soon">
          <div class="stack-soon-text">
            <span class="stack-badge soon"><i></i>Coming soon</span>
            <h3>Every stack, not just these.</h3>
            <p>Releases, rollbacks, supervised processes and health checks already work for any language. Next up:</p>
          </div>
          <div class="stack-soon-list">
            <ul class="chips chips-soon">
              {comingSoon.map((i) => <li>{i}</li>)}
            </ul>
            <a class="link-arrow" href={`${repo}/issues`} target="_blank" rel="noopener">Tell us what to ship first →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="section">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">Features</p>
          <h2>The ops work, done for you. You just ship.</h2>
          <p class="sub">Everything you'd otherwise script yourself, with sane defaults and nothing hidden.</p>
        </div>
        <div class="features">
          {features.map((f) => (
            <article class="feature">
              <span class={`ficon ficon-${f.icon}`} aria-hidden="true"></span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="how" class="section section-alt">
      <div class="wrap">
        <div class="section-head">
          <p class="kicker">How it works</p>
          <h2>From blank VPS to live app in three steps.</h2>
        </div>
        <ol class="steps">
          <li>
            <span class="step-n">1</span>
            <h3>Install</h3>
            <p>SSH in and paste one command. Skiff verifies its own checksum, starts up and prints a one-time HTTPS setup link, with the certificate fingerprint to check it against.</p>
            <pre class="snippet"><code><span class="c">$</span> curl -fsSL …/install.sh | sudo bash
<span class="ok">==&gt;</span> Verifying checksum
<span class="ok">==&gt;</span> Skiff v0.4.2 is running.
<span class="c">Open https://your-ip:8090/setup…</span></code></pre>
          </li>
          <li>
            <span class="step-n">2</span>
            <h3>Connect</h3>
            <p>Provision the box in one click, put the panel on its own HTTPS domain and connect your GitHub account.</p>
            <pre class="snippet"><code><span class="ok">==&gt;</span> Installing Nginx and PHP 8.4
<span class="ok">==&gt;</span> Configuring PHP-FPM
<span class="ok">✓</span> Server is ready</code></pre>
          </li>
          <li>
            <span class="step-n">3</span>
            <h3>Ship</h3>
            <p>Pick a repo, a framework and a domain. From then on, <code>git push</code> is all it takes.</p>
            <pre class="snippet"><code><span class="c">Deploy app.com (push a1b2c3d)</span>
<span class="ok">✓</span> built release 20261123115717
<span class="ok">✓</span> Live at https://app.com</code></pre>
          </li>
        </ol>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <div>
          <p class="kicker">No middleman</p>
          <h2>Your server. Your code. Your data.</h2>
          <p class="sub">There's no Skiff cloud in between. The panel runs next to your apps, talks to GitHub through an OAuth app you own and keeps its state in a single SQLite file on your machine.</p>
          <ul class="checks">
            <li>A failed deploy never touches the live release</li>
            <li>Webhooks are verified with a per-site secret</li>
            <li>Tokens never end up in git config or deploy scripts</li>
            <li>MySQL, PostgreSQL and Redis listen on localhost only</li>
            <li>Backups are root-only on disk; storage keys never hit a log</li>
            <li>Downloads (Skiff, Node.js, Composer) are checksum-verified</li>
          </ul>
        </div>
        <pre class="code-card"><code><span class="c"># the default Laravel deploy script, editable per site</span>
composer install --no-dev --optimize-autoloader

<span class="k">if</span> ! grep -q <span class="s">'^APP_KEY=base64:'</span> .env; <span class="k">then</span>
    php artisan key:generate --force
<span class="k">fi</span>

<span class="k">if</span> [ -f package.json ]; <span class="k">then</span>
    npm ci &amp;&amp; npm run build
<span class="k">fi</span>

php artisan migrate --force
php artisan optimize</code></pre>
      </div>
    </section>

    <section id="faq" class="section section-alt">
      <div class="wrap narrow">
        <div class="section-head">
          <p class="kicker">FAQ</p>
          <h2>Questions, answered.</h2>
        </div>
        <div class="faq">
          {faqs.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="cta">
      <div class="wrap cta-inner">
        <h2>Ship your next app to a server you own.</h2>
        <p class="sub">One command on a fresh Ubuntu box. That's the whole setup.</p>
        <InstallCommand />
        <div class="cta-actions">
          <a class="btn btn-primary" href={repo} target="_blank" rel="noopener">Star on GitHub</a>
          <a class="btn btn-ghost" href={`${repo}#readme`} target="_blank" rel="noopener">Read the docs</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer-row">
      <span class="brand small"><Logo size={20} /><span>Skiff</span></span>
      <span class="muted">Self-hosted deploys for Laravel, JavaScript and Python. More stacks soon.</span>
      <span class="spacer"></span>
      <a href="/docs">Docs</a>
      <a href={`${repo}/releases`} target="_blank" rel="noopener">Releases</a>
      <a href={repo} target="_blank" rel="noopener">GitHub</a>
    </div>
  </footer>
</Base>
